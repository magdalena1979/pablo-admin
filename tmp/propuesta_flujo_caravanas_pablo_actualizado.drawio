<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram id="propuesta-pablo" name="Propuesta para Pablo"><mxGraphModel dx="1400" dy="1800" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="2100" pageScale="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;PROPUESTA PARA DISCUTIR CON PABLO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Alta de caravanas e historial desde Gallagher&lt;br&gt;Actualizado 17/10/2026 · Confirmado: remito sin numeración y carga manual desde–hasta. Resto en propuesta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="25" width="1400" height="150" /></mxCell><mxCell id="step1" value="&lt;b&gt;1  Alta previa propuesta&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pablo registra cliente / razón social y sus establecimientos. Definir cómo se vinculan CUIT, campo y RENSPA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="200" width="650" height="180" /></mxCell><mxCell id="step2" value="&lt;b&gt;2  Remito y carga manual del rango&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confirmado por Pablo: el remito dice caravanas, sin numeración. Subirlo y registrar sus datos. Ingresar manualmente el rango desde–hasta, no una por una." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="420" width="650" height="180" /></mxCell><mxCell id="step3" value="&lt;b&gt;3  Registro del rango propuesto&lt;/b&gt;&lt;br&gt;&lt;br&gt;Propuesta: vincular rango manual, remito y cliente. No crear animales. Pendiente: confirmar si el rango es EID o caravana visual antes del cruce automático." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="640" width="650" height="180" /></mxCell><mxCell id="step4" value="&lt;b&gt;4  Trabajo a campo y exportación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pablo trabaja con Gallagher y exporta las sesiones CSV a una carpeta de Drive. Confirmar cómo identifica cliente y campo en cada sesión." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="860" width="650" height="180" /></mxCell><mxCell id="step5" value="&lt;b&gt;5  Archivos para revisar&lt;/b&gt;&lt;br&gt;&lt;br&gt;El sistema consulta la carpeta autorizada y prepara el análisis. Propuesta inicial: botón Revisar Drive. No importa automáticamente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1080" width="650" height="180" /></mxCell><mxCell id="step6" value="&lt;b&gt;6  Cruce por cada EID&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cruzar el EID del CSV con animales existentes. El vínculo al rango de compra requiere saber si es EID o visual y su correspondencia. No inferir la ubicación actual." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="200" width="650" height="180" /></mxCell><mxCell id="step7" value="&lt;b&gt;7  Revisión de excepciones&lt;/b&gt;&lt;br&gt;&lt;br&gt;EID desconocido, otro campo o cliente, etiqueta incompatible y reemplazo: revisión humana. Duplicados y archivos vacíos se informan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="420" width="650" height="180" /></mxCell><mxCell id="step8" value="&lt;b&gt;8  Vista previa y confirmación&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mostrar cliente y campo propuestos, altas, lecturas, trabajos y conflictos. Confirmar contexto y datos antes de escribir en la base." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="640" width="650" height="180" /></mxCell><mxCell id="step9" value="&lt;b&gt;9  Alta o vínculo e historial&lt;/b&gt;&lt;br&gt;&lt;br&gt;Crear o vincular animal con UUID. Conservar EID y caravana visual, fecha de lectura, archivo, fila, remito y decisiones del usuario." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="860" width="650" height="180" /></mxCell><mxCell id="step10" value="&lt;b&gt;10  Seguimiento y documentos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vincular factura al remito sin duplicar stock. Movimientos y declaración SENASA se registran con confirmación o respaldo separados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="1080" width="650" height="180" /></mxCell><mxCell id="edge1" edge="1" parent="1" source="step1" target="step2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#436B83;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" edge="1" parent="1" source="step2" target="step3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#436B83;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" edge="1" parent="1" source="step3" target="step4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#436B83;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" edge="1" parent="1" source="step4" target="step5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#436B83;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" edge="1" parent="1" source="step5" target="step6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#436B83;strokeWidth=3;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="745" y="1170" /><mxPoint x="745" y="290" /></Array></mxGeometry></mxCell><mxCell id="edge6" edge="1" parent="1" source="step6" target="step7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#436B83;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge7" edge="1" parent="1" source="step7" target="step8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#436B83;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge8" edge="1" parent="1" source="step8" target="step9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#436B83;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge9" edge="1" parent="1" source="step9" target="step10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#436B83;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="rules" value="&lt;b&gt;Reglas propuestas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compra ≠ colocación ≠ lectura ≠ movimiento ≠ declaración SENASA.&lt;br&gt;Conservar UUID e historial ante reemplazos. No inferir fechas ni traslados desde nombres de archivos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1F7;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1350" width="1405" height="150" /></mxCell><mxCell id="questions1" value="&lt;b&gt;Preguntas sobre la operación&lt;/b&gt;&lt;br&gt;&lt;br&gt;¿Cómo vincular razón social, cliente, campo y RENSPA?&lt;br&gt;¿El rango manual es EID o visual? ¿De dónde se obtiene y cómo se vincula con el EID?&lt;br&gt;¿Compra para un destino o distribuye stock?&lt;br&gt;¿Una sesión puede mezclar campos o clientes?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1540" width="680" height="300" /></mxCell><mxCell id="questions2" value="&lt;b&gt;Preguntas sobre eventos y responsables&lt;/b&gt;&lt;br&gt;&lt;br&gt;¿Qué significa Nueva etiqu. y cómo acredita colocación?&lt;br&gt;¿Cómo registra animales comprados y reemplazos?&lt;br&gt;¿Quién confirma importaciones, movimientos y SENASA?&lt;br&gt;¿Qué cuenta, carpeta y permisos de Drive usarían?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="1540" width="680" height="300" /></mxCell><mxCell id="scope" value="&lt;b&gt;Alcance inicial sugerido&lt;/b&gt;&lt;br&gt;&lt;br&gt;Revisar remito + carga manual desde–hasta + CSV con un caso real. Confirmar el tipo de identificador antes de cruzar el rango. Resto sujeto a revisión con Pablo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C8D6;fontColor=#263649;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=18;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1880" width="1405" height="150" /></mxCell></root></mxGraphModel></diagram></mxfile>