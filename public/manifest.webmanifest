{
  "id": "/",
  "name": "Pablo Mendivil | Gestión Agropecuaria",
  "short_name": "Gestión Agro",
  "lang": "es-AR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#10243f",
  "icons": [
    { "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/pwa/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/gallagher-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "csv", "accept": [".csv", "text/csv", "text/comma-separated-values", "application/vnd.ms-excel", "application/octet-stream"] }
      ]
    }
  }
}
